APP_ENV=development
DATABASE_URL=postgresql+psycopg://civil_engineering:civil_engineering@localhost:5432/civil_engineering
LOCAL_STORAGE_PATH=./storage
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:8000
# How long an archived project/file is kept before it's automatically purged.
ARCHIVE_RETENTION_DAYS=180
# An archived item within this many days of auto-purge is flagged as a warning.
ARCHIVE_PURGE_WARNING_DAYS=15
# How long a purge-history log entry is kept before it's cleaned up too.
PURGE_HISTORY_RETENTION_DAYS=365
